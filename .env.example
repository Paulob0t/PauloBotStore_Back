# ============================================
# PAULOBOT STORE - ENVIRONMENT CONFIGURATION
# ============================================

# Base de Datos (PostgreSQL en Podman)
DB_TYPE=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_USER=paulobot
DB_PASS=paulobot_password
DB_NAME=paulobot_store

# Base de Datos Remota / Nube (Opcional)
DB_NUBE_HOST=cpanel.ejemplo.com
DB_NUBE_USER=user_vending
DB_NUBE_PASS=your_secure_password
DB_NUBE_NAME=db_vending

# API Credenciales (Servicios)
API_USER=api_user
API_PASS=your_api_password
